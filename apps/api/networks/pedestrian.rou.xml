<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="passenger" vClass="passenger" accel="2.6" decel="4.5" sigma="0.5" length="5.0" maxSpeed="13.89"/>
    <vType id="bus" vClass="bus" accel="1.2" decel="4.0" sigma="0.5" length="12.0" maxSpeed="13.89"/>

    <route id="north_through" edges="north_in south_out"/>
    <route id="south_through" edges="south_in north_out"/>
    <route id="east_through"  edges="east_in west_out"/>
    <route id="west_through"  edges="west_in east_out"/>
    <route id="north_right"   edges="north_in west_out"/>
    <route id="south_right"   edges="south_in east_out"/>
    <route id="east_right"    edges="east_in north_out"/>
    <route id="west_right"    edges="west_in south_out"/>

    <flow id="flow_north_through" type="passenger" route="north_through" begin="0" end="3600" period="7" departLane="free"/>
    <flow id="flow_south_through" type="passenger" route="south_through" begin="0" end="3600" period="7" departLane="free"/>
    <flow id="flow_east_through"  type="passenger" route="east_through"  begin="0" end="3600" period="8" departLane="free"/>
    <flow id="flow_west_through"  type="passenger" route="west_through"  begin="0" end="3600" period="8" departLane="free"/>
    <flow id="flow_north_right"   type="passenger" route="north_right"   begin="0" end="3600" period="18" departLane="0"/>
    <flow id="flow_south_right"   type="passenger" route="south_right"   begin="0" end="3600" period="18" departLane="0"/>
    <flow id="flow_east_right"    type="passenger" route="east_right"    begin="0" end="3600" period="18" departLane="0"/>
    <flow id="flow_west_right"    type="passenger" route="west_right"    begin="0" end="3600" period="18" departLane="0"/>
    <flow id="flow_bus_north"     type="bus"       route="north_through" begin="0" end="3600" period="45" departLane="4"/>
    <flow id="flow_bus_south"     type="bus"       route="south_through" begin="0" end="3600" period="45" departLane="4"/>
</routes>
